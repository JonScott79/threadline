# Threadline — LANZAR ID NOVA Staging Environment Variables (Example / Zero Secrets)
# Keep production defaults untouched on `main`. Use these in NOVA staging only.

# --- Frontend (Vite / Netlify Staging) ---
VITE_LANZAR_AUTH_HUB_URL=https://auth.lanzar.me/nova
VITE_LANZAR_AUTH_API_URL=https://auth-api-nova.lanzar.me
VITE_LANZAR_OIDC_ISSUER=https://auth.lanzar.me/nova
VITE_API_URL=https://threadline-nova-api.up.railway.app/api

# Firebase Staging Web Config (lanzar-95ae3-dev)
VITE_FIREBASE_PROJECT_ID=lanzar-95ae3-dev
VITE_FIREBASE_AUTH_DOMAIN=lanzar-95ae3-dev.firebaseapp.com
VITE_FIREBASE_API_KEY=<lanzar-95ae3-dev-web-api-key>
VITE_FIREBASE_APP_ID=<lanzar-95ae3-dev-web-app-id>

# --- Backend (Express / Railway Staging) ---
NODE_ENV=production
LANZAR_AUTH_API_URL=https://auth-api-nova.lanzar.me
LANZAR_OIDC_ISSUER=https://auth.lanzar.me/nova
THREADLINE_ALLOWED_ORIGINS=https://threadline-nova.lanzar.me,http://localhost:5175
THREADLINE_AUTH_SECRET=<32+-byte-staging-only-hmac-secret>
